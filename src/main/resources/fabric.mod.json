{
	"schemaVersion": 1,
	"id": "serverstyler",
	"version": "${version}",
	"name": "ServerStyler",
	"description": "Customise multiplayer server names with full RGB colours, multi-stop linear gradients, opacity (ARGB) and formatting flags, edited from the native Add/Edit Server screen and rendered live in the multiplayer list.",
	"authors": [
		"zelekdev"
	],
	"contact": {
		"sources": "https://github.com/zelekdev/ServerStyler",
		"issues": "https://github.com/zelekdev/ServerStyler/issues"
	},
	"license": "MIT",
	"icon": "assets/serverstyler/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"pl.zelekdev.serverstyler.client.ServerStylerClient"
		],
		"modmenu": [
			"pl.zelekdev.serverstyler.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "serverstyler.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.buymeacoffee": "https://buymeacoffee.com/zelekdev"
			}
		}
	}
}